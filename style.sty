% --- Template Colors ---
\definecolor{coolGray}{HTML}{A0A0A0}
\definecolor{softSkyBlue}{HTML}{9AB8FD}
\definecolor{rosePink}{HTML}{E361A0}
\definecolor{coralOrange}{HTML}{FD8F60}
\definecolor{lavenderPurple}{HTML}{998BF2}
\definecolor{mintGreen}{HTML}{1CCA93}
\definecolor{warmAmber}{HTML}{FEC161}
\definecolor{brightRed}{HTML}{D40000}

% --- School Branding ---
\definecolor{schoolSecondary}{HTML}{FFD24F}
\definecolor{schoolPrimary}{HTML}{003069}

% --- Announcement Block ---
\newtcolorbox{block-announcement}[1]{
  enhanced,
  breakable,
  sharp corners,
  colback=schoolSecondary,
  colframe=schoolPrimary,
  coltext=black,
  boxrule=1pt,
  leftrule=3mm,
  before skip=1.25em,
  after skip=1.25em,
  left=4mm, right=4mm, top=3mm, bottom=3mm,
  fonttitle=\bfseries,
  coltitle=schoolPrimary,
  title={\ifstrempty{#1}{}{\faIcon{bullhorn}\hspace{0.5em}#1\\[1mm]\textcolor{schoolPrimary!30}{\rule{\linewidth}{0.5pt}}\vspace*{1mm}}},
  attach title to upper
}

\setmainfont{STIX Two Text}
\setmathfont{STIX Two Math}
\setmonofont{IBM Plex Mono}[Scale=MatchLowercase]

\RequirePackage{hyperref}
\RequirePackage[capitalize, nameinlink]{cleveref}